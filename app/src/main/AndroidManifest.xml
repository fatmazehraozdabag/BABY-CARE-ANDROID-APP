<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/babyphotos"
        android:roundIcon="@drawable/babyphotos"
        android:label="BabyCare"
        android:supportsRtl="true"
        android:theme="@style/Theme.BabyCare">

        <activity
            android:name=".BabyProfileActivity"
            android:exported="false" />

        <activity
            android:name=".DailySummaryActivity"
            android:exported="false" />

        <activity
            android:name=".FeedingActivity"
            android:exported="false" />

        <activity
            android:name=".SleepActivity"
            android:exported="false" />

        <activity
            android:name=".DiaperActivity"
            android:exported="false" />

        <activity
            android:name=".BathActivity"
            android:exported="false" />

        <activity
            android:name=".GrowthActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>


